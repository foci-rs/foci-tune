[Unit]
Description=foci-tune tuning service
After=network.target moonraker.service
Wants=moonraker.service

[Service]
Type=simple
User=pi
ExecStartPre=/usr/local/bin/foci-tune --check
ExecStart=/usr/local/bin/foci-tune --moonraker-url http://127.0.0.1:7125 --listen 0.0.0.0:7130
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
